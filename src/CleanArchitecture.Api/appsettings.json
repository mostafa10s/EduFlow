{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=app.db"
  },
  "Jwt": {
    "Issuer": "CleanArchitecture.Api",
    "Audience": "CleanArchitecture.Clients",
    "Secret": "REPLACE-WITH-AT-LEAST-32-CHARS-RANDOM-SECRET-KEY-FOR-PROD",
    "ExpiryMinutes": 60
  },
  "AllowedHosts": "*"
}
